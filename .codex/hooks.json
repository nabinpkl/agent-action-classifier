{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PROJECT_DIR}/repo_alignment/hooks/pre_edit_nudge.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PROJECT_DIR}/repo_alignment/hooks/end_of_turn_review.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
