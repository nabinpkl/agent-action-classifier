// Cedar schema for the org-graph model (ADR-0020): the principal is an Agent that sits in
// an org hierarchy via entity membership. Org <- Team <- User <- Agent are the structural
// nodes; Role is a cross-cutting RBAC group an Agent or User can also be `in`. A policy
// "attached at a node" is one scoped `principal in <Node>`; cascade-down is Cedar's
// transitive `in`, and sub-node override is Cedar's deny-overrides. Only Agents take
// actions, so the principal type stays [Agent]; the other types are groups it is `in`.

entity Org;
entity Team in [Org];
entity Role;
entity User in [Team, Role];
entity Agent in [User, Role];

entity DataScope = {
    sensitivity: String,
    pii: Bool,
};

action read, write, share, delete, execute appliesTo {
    principal: [Agent],
    resource: [DataScope],
};
