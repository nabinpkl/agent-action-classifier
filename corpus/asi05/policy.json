{
  "rules": [
    {
      "id": "R1-deny-remote-exec",
      "owasp": "ASI05",
      "lane": "deterministic",
      "match": { "shell_command_contains_any": ["| sh", "| bash", "rm -rf /"] },
      "outcome": "hard_deny"
    },
    {
      "id": "R2-allow-readonly",
      "owasp": "ASI05",
      "lane": "deterministic",
      "match": { "shell_command_contains_any": ["ls ", "cat ", "echo "] },
      "outcome": "hard_allow"
    },
    {
      "id": "R3-approve-etc-write",
      "owasp": "ASI05",
      "lane": "deterministic",
      "match": { "file_write_path_prefix": "/etc/" },
      "outcome": "requires_approval"
    },
    {
      "id": "R4-judge-interpreter",
      "owasp": "ASI05",
      "lane": "semantic",
      "match": { "shell_command_contains_any": ["python", "node"] },
      "outcome": "hard_allow"
    }
  ]
}
