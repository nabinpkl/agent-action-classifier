[
  {
    "name": "hard_deny_write_secrets",
    "action": { "principal": "agent-1", "action": "write", "resource": "secrets" },
    "context": { "approvals": [] },
    "expect": { "verdict": "deny", "gate_type": "hard", "owasp": "ASI05", "policy_id": "deny-secret-write" }
  },
  {
    "name": "hard_allow_public_read",
    "action": { "principal": "agent-1", "action": "read", "resource": "public-docs" },
    "context": { "approvals": [] },
    "expect": { "verdict": "allow", "gate_type": "hard", "owasp": "ASI05", "policy_id": "allow-public-read" }
  },
  {
    "name": "requires_approval_without_approval_escalates",
    "action": { "principal": "agent-1", "action": "write", "resource": "app-config" },
    "context": { "approvals": [] },
    "expect": { "verdict": "escalate", "gate_type": "soft", "owasp": "ASI05", "policy_id": "approve-restricted-write" }
  },
  {
    "name": "requires_approval_with_valid_approval_allows_soft",
    "action": { "principal": "agent-1", "action": "write", "resource": "app-config", "at": 1000 },
    "context": { "approvals": [{ "scope": "this_action", "granted_by": "alice", "expires": 2000 }] },
    "expect": { "verdict": "allow", "gate_type": "soft", "owasp": "ASI05", "policy_id": "approve-restricted-write" }
  },
  {
    "name": "expired_approval_does_not_satisfy",
    "action": { "principal": "agent-1", "action": "write", "resource": "app-config", "at": 1000 },
    "context": { "approvals": [{ "scope": "this_action", "granted_by": "alice", "expires": 500 }] },
    "expect": { "verdict": "escalate", "gate_type": "soft", "owasp": "ASI05", "policy_id": "approve-restricted-write" }
  },
  {
    "name": "semantic_clause_escalates_to_judge",
    "action": { "principal": "agent-1", "action": "read", "resource": "customer-records" },
    "context": { "approvals": [] },
    "expect": { "verdict": "escalate", "gate_type": "soft", "owasp": "ASI05", "policy_id": "judge-pii-read" }
  },
  {
    "name": "semantic_clause_shadows_hard_allow",
    "action": { "principal": "agent-1", "action": "read", "resource": "public-pii-export" },
    "context": { "approvals": [] },
    "expect": { "verdict": "escalate", "gate_type": "soft", "owasp": "ASI05", "policy_id": "judge-pii-read" }
  },
  {
    "name": "hard_deny_is_unoverridable_by_approval",
    "action": { "principal": "agent-1", "action": "write", "resource": "secrets", "at": 1000 },
    "context": { "approvals": [{ "scope": "this_action", "granted_by": "alice", "expires": 9999 }] },
    "expect": { "verdict": "deny", "gate_type": "hard", "owasp": "ASI05", "policy_id": "deny-secret-write" }
  },
  {
    "name": "no_applicable_rule_defaults_to_escalate",
    "action": { "principal": "agent-1", "action": "delete", "resource": "telemetry" },
    "context": { "approvals": [] },
    "expect": { "verdict": "escalate", "gate_type": "soft", "owasp": null, "policy_id": null }
  }
]
