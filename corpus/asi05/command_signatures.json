  { "pattern": "\\bpipx\\s+install\\b", "kind": "package_install" },
  { "pattern": "\\b(pip|pip3)\\s+install\\b", "kind": "package_install" },
  { "pattern": "\\bpython3?\\s+-m\\s+pip\\s+install\\b", "kind": "package_install" },
  { "pattern": "\\bcargo\\s+(install|add)\\b", "kind": "package_install" },
  { "pattern": "\\bbrew\\s+install\\b", "kind": "package_install" },
  { "pattern": "\\bgem\\s+install\\b", "kind": "package_install" },
  { "pattern": "\\bgo\\s+install\\b", "kind": "package_install" },
